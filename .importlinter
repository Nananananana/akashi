[importlinter]
include_external_packages = True
root_packages =
    akashi

# The direction, asserted. The stdlib-only rule for the domain is a separate
# check in tests/test_architecture.py, because import-linter cannot express
# "everything except the standard library".
#
# The parentheses mark a layer as optional. Layers are named here before the
# package exists so that the first module to appear in one is already governed
# -- a layering rule written after the code is a rule written around it.
[importlinter:contract:layers]
name = Layer dependency direction
type = layers
layers =
    (akashi.interfaces)
    (akashi.evaluation)
    (akashi.application)
    (akashi.infrastructure)
    (akashi.ports)
    (akashi.domain)
exhaustive = false

# ADR-0003: an audit is reproducible, and a component that can reach the
# network can neither be reproduced nor be run inside the networks that most
# need it. akashi audits locally or it does not audit. Unlike tsumugi there is
# no networked adapter to carve out an exception for -- there is nothing akashi
# needs from anywhere else.
[importlinter:contract:no-network]
# **This checks what akashi imports, not what akashi's dependencies do**, and
# the difference did not exist until now. Measured rather than assumed:
#
#     a module here writing `import socket`      BROKEN
#     a module here writing `import anthropic`   KEPT      (anthropic opens sockets)
#
# import-linter does not traverse into an external package, so while akashi had
# zero dependencies this contract and the sentence "nothing in akashi touches
# the network" were the same statement. ADR-0017 installs an SDK behind an
# extra, and they stopped being the same statement that day.
#
# What still guarantees the base install is offline is that it **has no
# dependencies at all**, checked on the built artefact by the CI job named "the
# dependency count is zero" rather than by this file. What guarantees the
# `claude` extra stays one door is `only-the-judge-reaches-out` below.
#
# No `ignore_imports` for the judge adapter: it named a module this contract
# cannot see anyway, and an exception that protects nothing is worse than none
# -- it implies a check that is not happening.
name = No module in akashi imports a networking module
type = forbidden
source_modules =
    akashi
forbidden_modules =
    socket
    ssl
    http
    urllib
    asyncio

[importlinter:contract:only-the-judge-reaches-out]
# The SDK is named in one module, and `akashi.infrastructure.adapters` does not
# re-export it -- so `import akashi` reaches no HTTP client even on a machine
# with the extra installed. The contract is what found that it did.
#
# `akashi.interfaces` is not on this list, and that is not a hole. The CLI is
# the composition root: its own docstring says it is the only module that knows
# the language packs exist, and knowing which adapters exist is the same job.
# Somebody has to wire a judge in, it has to be the layer that owns the
# command line, and the import there is inside the `--judge` branch so that the
# cost is paid by a caller who asked for it.
#
# What this forbids is everything that decides anything: no verdict is computed
# in a module that can see a model.
name = Only the judge adapter may name the Anthropic SDK
type = forbidden
source_modules =
    akashi.domain
    akashi.ports
    akashi.application
    akashi.evaluation
    akashi.infrastructure.packages
    akashi.infrastructure.rendering
    akashi.infrastructure.reports
    akashi.infrastructure.settings
    akashi.infrastructure.installation
    akashi.infrastructure.adapters.mamori
forbidden_modules =
    anthropic

# ADR-0007: akashi reads a ContextPackage as a document, against a published
# schema, and imports tsumugi nowhere -- not even in an adapter. The seam tests
# install the reference producer from source; nothing under src/ may name it.
[importlinter:contract:the-producer-is-never-imported]
name = akashi imports neither tsumugi nor kiseki, anywhere
type = forbidden
source_modules =
    akashi
forbidden_modules =
    tsumugi
    kiseki

# The domain does its own I/O nowhere. Reading a package is the filesystem
# adapter's job; where a report is written is the interface's job. Where a
# *segment* is written is nobody's -- the domain is handed strings.
[importlinter:contract:domain-no-io]
name = The domain layer does not touch the filesystem
type = forbidden
source_modules =
    akashi.domain
forbidden_modules =
    pathlib
    os
    sqlite3
    tomllib
    argparse

# ADR-0001 and the layer table in AGENTS.md. The domain knows about no layer
# above it, which is what makes it testable with nothing else constructed.
[importlinter:contract:domain-purity]
name = The domain layer knows nothing below it
type = forbidden
source_modules =
    akashi.domain
forbidden_modules =
    akashi.ports
    akashi.application
    akashi.infrastructure
    akashi.interfaces
    akashi.evaluation

# ADR-0008: a response still carrying placeholders is restored before it is
# audited, or it is refused. The optional adapter that can do the restoring is
# the one place allowed to know mamori exists; everything above it is handed a
# restorer or nothing. Listed layer by layer rather than by excluding the
# adapters, so that a new infrastructure package has to be added here -- the
# same maintenance obligation as the layer table, and the same reason for it.
[importlinter:contract:the-redactor-is-optional]
name = Only the adapters may know about mamori
type = forbidden
source_modules =
    akashi.domain
    akashi.ports
    akashi.application
    akashi.evaluation
    akashi.interfaces
forbidden_modules =
    mamori
