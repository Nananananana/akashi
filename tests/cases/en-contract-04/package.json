        "document_hash": "sha256:6f2f77f20e822a7096783b5d379ce151c1156e3260141480e20d41c564f08b07"
      },
      "provenance": {
        "layer": "fact",
        "producer": "akashi.cases/1"
      },
      "selection": {
        "rank": 1,
        "score": 0.9
      },
      "cost": 36
    },
    {
      "item_id": "itm_02",
      "kind": "document_span",
      "text": "Liability under Art. 12 is capped at 45,000 dollars in aggregate.",
      "anchor": {
        "document_id": "doc_msa_en",
        "source_path": "contracts/2025-msa.md",
        "section": "Terms",
        "start": 210,
        "end": 275,
        "text_hash": "sha256:412a516840457226ae88996bc159ccebec2508ebf2698ab496dbed6b22c45d1e",
        "document_hash": "sha256:6f2f77f20e822a7096783b5d379ce151c1156e3260141480e20d41c564f08b07"
      },
      "provenance": {
        "layer": "fact",
        "producer": "akashi.cases/1"
      },
      "selection": {
        "rank": 2,
        "score": 0.9
      },
      "cost": 32
    },
    {
      "item_id": "itm_03",
      "kind": "document_span",
      "text": "Invoices fall due within 45 days of receipt, and interest accrues at 3.5% per annum.",
      "anchor": {
        "document_id": "doc_msa_en",
        "source_path": "contracts/2025-msa.md",
        "section": "Terms",
        "start": 277,
        "end": 361,
        "text_hash": "sha256:50804f563bafd000a03a43de4d86e4baccb42a71c4212171633623c3d98ea3db",
        "document_hash": "sha256:6f2f77f20e822a7096783b5d379ce151c1156e3260141480e20d41c564f08b07"
      },
      "provenance": {
        "layer": "fact",
        "producer": "akashi.cases/1"
      },
      "selection": {
        "rank": 3,
        "score": 0.9
      },
      "cost": 42
    },
    {
      "item_id": "itm_04",
      "kind": "document_span",
      "text": "The term is 3 years, renewing automatically unless notice is given 60 days in advance.",
      "anchor": {
        "document_id": "doc_amend_en",
