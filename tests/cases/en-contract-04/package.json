  "query": "what is the notice period and the cap on liability?",
  "items": [
    {
      "item_id": "itm_01",
      "kind": "document_span",
      "text": "Under Section 4(b), either party may terminate on 30 days written notice.",
      "anchor": {
        "document_id": "doc_msa_en",
        "source_path": "contracts/2025-msa.md",
        "section": "Terms",
        "start": 135,
        "end": 208,
